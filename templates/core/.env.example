MONGO_URI=mongodb_config_uri
FIREBASE_SERVICE_ACCOUNT_KEY=stringified_json_arvice_account_key
PORT=port_number
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
# S3-compatible object storage - used only if the "storage" plugin is installed. One driver
# serves every provider below; they differ only by endpoint/region/path-style, not by API.
# Cloudflare R2:       STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  STORAGE_REGION=auto        STORAGE_FORCE_PATH_STYLE=true
# AWS S3:              STORAGE_ENDPOINT=https://s3.<region>.amazonaws.com              STORAGE_REGION=<region>    STORAGE_FORCE_PATH_STYLE=false
# DigitalOcean Spaces: STORAGE_ENDPOINT=https://<region>.digitaloceanspaces.com        STORAGE_REGION=<region>    STORAGE_FORCE_PATH_STYLE=false
# Custom/self-hosted (e.g. MinIO): set STORAGE_ENDPOINT to your API endpoint; STORAGE_FORCE_PATH_STYLE=true is usually required
STORAGE_ENDPOINT=your_s3_compatible_endpoint_url
STORAGE_REGION=auto
STORAGE_BUCKET=your_bucket_name
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
# The URL that actually serves the bucket publicly (custom domain / CDN / the provider's own
# public host, e.g. R2's *.r2.dev) - distinct from STORAGE_ENDPOINT, which is only used for
# authenticated PUT/DELETE calls.
STORAGE_PUBLIC_BASE_URL=your_public_bucket_url
STORAGE_FORCE_PATH_STYLE=false