{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "Products with variants and stock, a per-user cart, promo codes, shipping methods, and a Stripe-backed checkout with one-time and recurring (subscription) billing - extensible to any purchasable collection via PurchasableSource adapters",
  "dependencies": {
    "npm": {
      "stripe": "^22.6.2",
      "@stripe/stripe-js": "^9.17.0",
      "@stripe/react-stripe-js": "^6.12.0",
      "multer": "^2.0.0",
      "@types/multer": "^1.4.12"
    },
    "plugins": []
  },
  "injections": [
