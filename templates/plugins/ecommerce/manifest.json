    { "target": "libs/api-client/src/endpoints/ecommerce.endpoints.ts", "source": "src/api-client/endpoints/ecommerce.endpoints.ts" },
    { "target": "libs/api-client/src/ecommerce/storefront.ts", "source": "src/api-client/ecommerce/storefront.ts" },
    { "target": "libs/api-client/src/baseApi.ts", "source": "src/api-client/baseApi.fragment.ts", "strategy": "merge" },
    { "target": "libs/api-client/src/index.ts", "source": "src/api-client/index.fragment.ts", "strategy": "merge" },

