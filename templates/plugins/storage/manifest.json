{
  "name": "storage",
  "version": "1.0.0",
  "description": "S3-compatible object storage (Cloudflare R2 / AWS S3 / DigitalOcean Spaces / custom), Asset metadata, and a reusable MediaField upload UI",
  "dependencies": {
    "npm": {
      "@aws-sdk/client-s3": "^3.700.0",
      "@aws-sdk/s3-request-presigner": "^3.700.0",
      "multer": "^2.0.0",
      "@types/multer": "^1.4.12"
    },
    "plugins": []
  },
  "injections": [
    { "target": "libs/storage/package.json", "source": "src/storage/package.json" },
    { "target": "libs/storage/project.json", "source": "src/storage/project.json" },
    { "target": "libs/storage/tsconfig.json", "source": "src/storage/tsconfig.json" },
    { "target": "libs/storage/tsconfig.lib.json", "source": "src/storage/tsconfig.lib.json" },
    { "target": "libs/storage/src/contracts/storage-provider.contract.ts", "source": "src/storage/contracts/storage-provider.contract.ts" },
    { "target": "libs/storage/src/providers/s3/s3.provider.ts", "source": "src/storage/providers/s3/s3.provider.ts" },
    { "target": "libs/storage/src/index.ts", "source": "src/storage/index.ts" },

    { "target": "libs/db/src/contracts/asset.contract.ts", "source": "src/db/contracts/asset.contract.ts" },
    { "target": "libs/db/src/schemas/asset.schema.ts", "source": "src/db/schemas/asset.schema.ts" },
    { "target": "libs/db/src/providers/mongo/asset.repository.ts", "source": "src/db/providers/mongo/asset.repository.ts" },
    { "target": "libs/db/src/contracts/db-provider.contract.ts", "source": "src/db/contracts/db-provider.contract.ts" },
    { "target": "libs/db/src/providers/mongo/mongo.provider.ts", "source": "src/db/providers/mongo/mongo.provider.ts" },
    { "target": "libs/db/src/index.ts", "source": "src/db/index.ts" },

    { "target": "libs/api-core/src/schemas/storage.schema.ts", "source": "src/api-core/schemas/storage.schema.ts" },
    { "target": "libs/api-core/src/routes/storage.route.ts", "source": "src/api-core/routes/storage.route.ts" },
    { "target": "libs/api-core/src/index.ts", "source": "src/api-core/index.ts" },

    { "target": "libs/api-client/src/endpoints/storage.endpoints.ts", "source": "src/api-client/endpoints/storage.endpoints.ts" },
    { "target": "libs/api-client/src/index.ts", "source": "src/api-client/index.ts" },

    { "target": "libs/ui/src/composites/MediaField.tsx", "source": "src/ui/composites/MediaField.tsx" },
    { "target": "libs/ui/src/composites/AvatarEditDialog.tsx", "source": "src/ui/composites/AvatarEditDialog.tsx" },
    { "target": "libs/ui/src/composites/BannerEditDialog.tsx", "source": "src/ui/composites/BannerEditDialog.tsx" },
    { "target": "libs/ui/src/composites/index.ts", "source": "src/ui/composites/index.ts" },
    { "target": "libs/ui/src/index.ts", "source": "src/ui/index.ts" },
    { "target": "libs/ui/tsconfig.lib.json", "source": "src/ui/tsconfig.lib.json" },

    { "target": "tsconfig.base.json", "source": "src/tsconfig.base.json" }
  ]
}
