{
  "name": "db-firebase",
  "version": "1.0.0",
  "description": "Firebase Firestore database provider implementation for @inithium/db",
  "dependencies": {
    "npm": {
      "firebase-admin": "^12.0.0"
    },
    "plugins": []
  },
  "injections": [
    {
      "target": "libs/db/src/providers/firebase/firebase.provider.ts",
      "source": "src/firebase/firebase.provider.ts"
    },
    {
      "target": "libs/db/src/providers/firebase/userRepositoryFirebase.ts",
      "source": "src/firebase/userRepositoryFirebase.ts"
    },
    {
      "target": "libs/db/src/providers/firebase/pageRepositoryFirebase.ts",
      "source": "src/firebase/pageRepositoryFirebase.ts"
    },
    {
      "target": "libs/db/src/providers/firebase/notificationRepositoryFirebase.ts",
      "source": "src/firebase/notificationRepositoryFirebase.ts"
    },
    {
      "target": "libs/db/src/providers/firebase/settingsRepositoryFirebase.ts",
      "source": "src/firebase/settingsRepositoryFirebase.ts"
    },
    {
      "target": "libs/db/src/providers/active-provider.ts",
      "source": "src/active-provider.ts"
    }
  ]
}
