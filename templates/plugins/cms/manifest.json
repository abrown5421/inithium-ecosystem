{
  "name": "cms",
  "version": "1.0.0",
  "description": "Role-gated, code-split admin CMS area embedded in apps/web at /cms",
  "dependencies": {
    "npm": {
      "recharts": "^2.15.0"
    },
    "plugins": []
  },
  "injections": [
    { "target": "libs/cms", "source": "src/cms" },

    { "target": "apps/web/src/app/RootRouter.tsx", "source": "src/app/RootRouter.fragment.tsx", "strategy": "merge" },

    { "target": "libs/permissions/src/roles/role-capability-defaults.ts", "source": "src/permissions/roles/role-capability-defaults.fragment.ts", "strategy": "merge" },

    { "target": "tsconfig.base.json", "source": "src/tsconfig-paths.fragment.json", "strategy": "tsconfig-paths-merge" },

    { "target": "libs/ui/src/composites/ListRow.tsx", "source": "src/ui/composites/ListRow.tsx" },
    { "target": "libs/ui/src/composites/SearchFilterBar.tsx", "source": "src/ui/composites/SearchFilterBar.tsx" },
    { "target": "libs/ui/src/composites/useSelection.ts", "source": "src/ui/composites/useSelection.ts" },
    { "target": "libs/ui/src/composites/index.ts", "source": "src/ui/composites/index.fragment.ts", "strategy": "merge" },
    { "target": "libs/ui/src/index.ts", "source": "src/ui/index.fragment.ts", "strategy": "merge" }
  ]
}
